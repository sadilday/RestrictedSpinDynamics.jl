url: "https://sadilday.github.io/RestrictedSpinDynamics.jl"
keywords:
  - NMR
  - spin dynamics
  - open quantum systems
  - Lindblad master equation
  - Nakajima-Zwanzig
  - RASER
  - zero-field NMR
  - Julia
